# --- data (downloaded per starter_kit/README.md; never committed) ---
starter_kit/KuaiRand-Pure/
starter_kit/KuaiRand-Pure.tar.gz
data_cache/

# --- python ---
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/

# --- editors / os ---
.DS_Store
.idea/
.vscode/
